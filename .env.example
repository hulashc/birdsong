# Birdsong environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required for LLM features (/api/describe, /api/search, /api/chat)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional — path to the processed data file (default: birdsong_data.json)
BIRDSONG_DATA_PATH=birdsong_data.json

# Required when running locally (adds repo root to Python's import path)
PYTHONPATH=.
